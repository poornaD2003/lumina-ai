generator client {
  provider = "prisma-client-js"
}

// Prisma 7: connection URLs live in prisma.config.ts (for the CLI) and are
// passed as a driver adapter to PrismaClient (for the app). The datasource
// block only declares the provider.
datasource db {
  provider = "sqlite"
}

model Customer {
  id              Int      @id @default(autoincrement())
  name            String
  email           String   @unique
  phone           String?
  segment         String   // Corporate, Education, Gaming, Individual
  region          String   // West, South, North, East, Central
  lifetimeValue   Float    @default(0)
  acquisitionDate DateTime
  isActive        Boolean  @default(true)
  sales           Sale[]
}

model Supplier {
  id           Int       @id @default(autoincrement())
  name         String
  email        String?
  phone        String?
  leadTimeDays Int       @default(7)
  products     Product[]
}

model Product {
  id             Int     @id @default(autoincrement())
  name           String
  sku            String  @unique
  brand          String  // ASUS, Dell, HP, Apple, Lenovo, MSI, Acer, LG, etc.
  category       String  // Gaming Laptop, Ultrabook, Business Laptop, Standard Laptop, Workstation, Accessories
  processor      String?
  ram            String?
  storage        String?
  displaySize    String?
  unitPrice      Float
  costPrice      Float
  competitorPrice     Float?   
  aiSuggestedPrice    Float?   
  aiPricingReason     String?  
  stockQuantity  Int
  reorderLevel   Int     @default(5)
  warrantyMonths Int     @default(12)
  supplierId     Int?
  supplier       Supplier? @relation(fields: [supplierId], references: [id])
  sales          Sale[]
  purchaseItems  PurchaseOrderItem[]
}

model Sale {
  id          Int      @id @default(autoincrement())
  customerId  Int
  productId   Int
  quantity    Int
  unitPrice   Float
  totalAmount Float
  saleDate    DateTime
  region      String
  paymentMode String   // Cash, Card, Bank Transfer, Lease Financing
  customer    Customer @relation(fields: [customerId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])
}

model FinancialRecord {
  id          Int      @id @default(autoincrement())
  recordDate  DateTime
  recordType  String   // Revenue, Expense, COGS, Tax
  category    String   // Gaming Laptop, Ultrabook, Salaries, Rent, Marketing, etc.
  amount      Float
  description String?
}

model DailyNetProfit {
  id            Int      @id @default(autoincrement())
  date          String   // ISO calendar date: YYYY-MM-DD
  productId     Int?
  productName   String?
  quantity      Int      @default(0)
  sellingPrice  Float    @default(0)
  unitCost      Float    @default(0)
  revenue       Float
  costOfGoods   Float
  netProfit     Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([date, productId])
}

model ChatMessage {
  id          Int      @id @default(autoincrement())
  role        String   // user, assistant
  content     String
  source      String?  // ai, fallback (for assistant messages)
  createdAt   DateTime @default(now())
}

// Purchase orders persist the restock decisions so the store has a live
// record of what is on order, and receiving an order closes the loop by
// increasing product stock.
model PurchaseOrder {
  id           Int                  @id @default(autoincrement())
  poNumber     String               @unique
  supplierName String
  status       String               @default("PENDING") // PENDING, RECEIVED, CANCELLED
  expectedDate DateTime
  totalAmount  Float                @default(0)
  createdAt    DateTime             @default(now())
  receivedAt   DateTime?
  items        PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              Int            @id @default(autoincrement())
  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       Int
  product         Product        @relation(fields: [productId], references: [id])
  productName     String         // snapshot of the name at order time
  quantity        Int
  unitCost        Float
}
